{
    "name": "ahmed1911/belegwerk",
    "description": "PDF documents from sandboxed Twig templates via Gotenberg, plus e-invoices (XRechnung, ZUGFeRD/Factur-X).",
    "type": "library",
    "license": "MIT",
    "keywords": ["pdf", "invoice", "e-invoice", "xrechnung", "zugferd", "factur-x", "twig", "gotenberg"],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "bacon/bacon-qr-code": "^3.0",
        "horstoeko/mimedb": "^1.0.2",
        "horstoeko/zugferd": "^1.0.131",
        "symfony/validator": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.29"
    },
    "conflict": {
        "jms/serializer": "<3.15"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "smalot/pdfparser": "^2"
    },
    "autoload": {
        "psr-4": {
            "Belegwerk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Belegwerk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
