{% set weekdays = ['Sonntag', 'Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag'] -%}
{% set zero_rate_labels = {Z: 'Nullsatz', E: 'steuerbefreit', AE: 'Reverse Charge', K: 'innergemeinschaftliche Lieferung', G: 'Ausfuhrlieferung'} -%}
{% set tax_notes = [] -%}
{% for tax in tax_groups -%}
    {% if tax.exemption_reason and tax.exemption_reason not in tax_notes %}{% set tax_notes = tax_notes|merge([tax.exemption_reason]) %}{% endif -%}
{% endfor -%}
<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <title>Rechnung {{ number }}</title>
    <style>
        @page { size: A4; margin: 5mm 18.5mm 50mm; }

        * { box-sizing: border-box; }
        html { font-family: Arial, sans-serif; color: #111; }
        body { margin: 0; font-size: 10.5pt; line-height: 1.22; }
        strong { font-weight: 700; }

        .letterhead { min-height: 48mm; display: flex; justify-content: flex-end; align-items: flex-start; padding-top: 8mm; }
        .brand-logo { max-width: 58mm; max-height: 22mm; }
        .brand-name { max-width: 75mm; font-size: 24pt; line-height: 1.05; font-weight: 700; text-align: right; overflow-wrap: anywhere; }
        .sender-line { font-size: 7.5pt; color: #555; margin-bottom: 5mm; overflow-wrap: anywhere; }
        .address-block { min-height: 30mm; position: relative; break-inside: avoid; }
        .recipient { max-width: 92mm; overflow-wrap: anywhere; }
        .recipient strong { font-weight: 400; }
        .invoice-date { text-align: right; margin-top: 4mm; overflow-wrap: anywhere; }
        .invoice-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 4mm 5mm; margin: 3mm 0 4mm; }
        .fact { display: grid; grid-template-columns: 52% 48%; align-content: start; min-width: 0; break-inside: avoid; }
        .fact strong, .fact span { overflow-wrap: anywhere; }
        .fact strong { margin-right: 1mm; }
        .fact-stacked { display: block; }
        .fact-stacked span { display: block; margin-top: 1mm; }
        .fact-wide { grid-column: 1 / -1; display: flex; gap: 1mm; }
        .intro { margin: 0 0 5mm; break-inside: avoid; overflow-wrap: anywhere; }
        .service-heading { font-size: 10.5pt; margin: 0 0 4mm; break-after: avoid; }

        .items { width: 100%; table-layout: fixed; border-collapse: collapse; }
        .description-col { width: 65%; }
        .quantity-col { width: 12%; }
        .price-col { width: 11%; }
        .total-col { width: 12%; }
        .items thead { display: table-header-group; }
        .items th { text-align: left; border-bottom: .8mm solid #999; padding: 0 0 1.5mm; font-size: 10pt; }
        .items td { vertical-align: top; padding: .65mm 0; font-size: 9pt; }
        .items th, .items td { overflow-wrap: anywhere; word-break: break-word; }
        .items .num { text-align: right; }
        .items tr { break-inside: avoid; page-break-inside: avoid; }

        .invoice-totals { margin-top: 7mm; break-inside: avoid; page-break-inside: avoid; }
        .total-row { display: flex; justify-content: space-between; gap: 5mm; padding: 1mm 0; }
        .total-row span:last-child, .total-row strong:last-child { text-align: right; }
        .grand-total { border-top: .7mm solid #999; padding-top: 2mm; margin-top: 1mm; }
        .payment-info { margin-top: 8mm; break-inside: avoid; page-break-inside: avoid; overflow-wrap: anywhere; }
        .payment-qr { display: flex; align-items: center; gap: 4mm; }
        .payment-qr img { width: 20mm; height: 20mm; flex: none; }
        .tax-note { margin: 3mm 0 0; font-size: 9pt; overflow-wrap: anywhere; }
    </style>
</head>
<body>
    <header class="letterhead">
        {% if custom.logo %}
            <img class="brand-logo" src="{{ custom.logo }}" alt="">
        {% else %}
            <div class="brand-name">{{ seller.name }}</div>
        {% endif %}
    </header>

    <div class="sender-line">
        {{- seller.name }} | {{ seller.address.street }}
        {%- if seller.address.additional %} | {{ seller.address.additional }}{% endif %} | {{ seller.address.zip }} {{ seller.address.city }}
        {%- if seller.address.country != 'DE' %} | {{ seller.address.country }}{% endif -%}
    </div>
    <section class="address-block">
        <div class="recipient">
            <strong>{{ buyer.name }}</strong>
            {%- if buyer.address.street %}<br>{{ buyer.address.street }}{% endif %}
            {%- if buyer.address.additional %}<br>{{ buyer.address.additional }}{% endif %}
            <br>{{ buyer.address.zip }} {{ buyer.address.city }}
            {%- if buyer.address.country != 'DE' %}<br>{{ buyer.address.country }}{% endif %}
        </div>
        <div class="invoice-date">{{ seller.address.city }}, den {{ date|date('d.m.Y') }}</div>
    </section>

    <section class="invoice-facts">
        {% if period %}
            <div class="fact fact-stacked"><strong>Rechnung für Zeitraum:</strong><span>{{ period.start|date('d.m.Y') }} – {{ period.end|date('d.m.Y') }}</span></div>
        {% elseif service_date %}
            <div class="fact fact-stacked"><strong>Rechnung für Zeitraum:</strong><span>{{ service_date|date('d.m.Y') }}</span></div>
        {% endif %}
        {% if custom.occasion %}<div class="fact"><strong>Anlass/Einsatzort:</strong><span>{{ custom.occasion|nl2br }}</span></div>{% endif %}
        <div class="fact fact-stacked"><strong>Rechnungsnummer:</strong><span>{{ number }}</span></div>
        {% if custom.project %}<div class="fact"><strong>Kostenstelle/Projekt:</strong><span>{{ custom.project }}</span></div>{% endif %}
        {% if buyer_reference %}<div class="fact"><strong>Ihre Referenz:</strong><span>{{ buyer_reference }}</span></div>{% endif %}
        {% if custom.orderer %}<div class="fact fact-wide"><strong>Besteller:</strong><span>{{ custom.orderer }}</span></div>{% endif %}
    </section>

    {% if note %}<p class="intro">{{ note|nl2br }}</p>{% endif %}
    {% if service_date %}<h1 class="service-heading">{{ weekdays[service_date|date('w')] }}, {{ service_date|date('d.m.Y') }}</h1>{% endif %}

    <table class="items">
        <colgroup><col class="description-col"><col class="quantity-col"><col class="price-col"><col class="total-col"></colgroup>
        <thead><tr><th>{{ custom.section_title }}</th><th class="num">Anzahl</th><th class="num">Preis</th><th class="num">Gesamt</th></tr></thead>
        <tbody>
            {% for line in lines %}
                <tr>
                    <td>
                        {{ line.description|nl2br }}
                        {% for label, entries in {'abzgl.': line.allowances, 'zzgl.': line.charges} %}{% for adjustment in entries %}<br><small>{{ label }} {{ adjustment.reason }}{% if adjustment.percent %} {{ adjustment.percent|replace({'.': ','}) }} %{% endif %}: {{ adjustment.amount_cents|money }}</small>{% endfor %}{% endfor %}
                    </td>
                    <td class="num">{{ line.quantity|replace({'.': ','}) }} {{ line.unit }}</td>
                    <td class="num">{{ line.unit_price_cents|money }}</td>
                    <td class="num">{{ line.net_cents|money }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <section class="invoice-totals" aria-label="Rechnungssummen">
        {% if allowances or charges %}
            <div class="total-row"><span>Summe Positionen</span><span>{{ totals.line_total_cents|money }}</span></div>
            {% for label, entries in {'abzgl.': allowances, 'zzgl.': charges} %}
                {% for adjustment in entries %}
                    <div class="total-row"><span>{{ label }} {{ adjustment.reason }}{% if adjustment.percent %} {{ adjustment.percent|replace({'.': ','}) }} %{% endif %}{% if tax_groups|length > 1 %} ({{ adjustment.tax_rate|replace({'.': ','}) }} % USt.){% endif %}</span><span>{% if label == 'abzgl.' %}−{% endif %}{{ adjustment.amount_cents|money }}</span></div>
                {% endfor %}
            {% endfor %}
        {% endif %}
        <div class="total-row"><span>Summe netto</span><span>{{ totals.net_cents|money }}</span></div>
        {% for tax in tax_groups %}
            <div class="total-row">
                <span>{% if tax.category == 'S' %}zzgl. USt. {{ tax.rate|replace({'.': ','}) }} %{% else %}USt. 0 % ({{ zero_rate_labels[tax.category] }}){% endif %}</span>
                <span>{{ tax.amount_cents|money }}</span>
            </div>
        {% endfor %}
        <div class="total-row grand-total"><span>Gesamtbetrag</span><strong>{{ totals.gross_cents|money }}</strong></div>
        {% if tax_notes %}<p class="tax-note">{{ tax_notes|join("\n")|nl2br }}</p>{% endif %}
    </section>

    {% if direct_debit %}
    <section class="payment-info">
        Der Gesamtbetrag wird zum {{ due_date|date('d.m.Y') }} per SEPA-Lastschrift (Mandat {{ direct_debit.mandate_reference }}) eingezogen.
    </section>
    {% elseif bank %}
    <section class="payment-info{% if payment_qr %} payment-qr{% endif %}">
        {% if payment_qr %}<img src="{{ payment_qr }}" alt="GiroCode">{% endif %}
        <span>Bitte überweisen Sie {% if totals.paid_cents > 0 %}den offenen Betrag von {{ totals.due_cents|money }}{% else %}den Gesamtbetrag{% endif %} bis zum {{ due_date|date('d.m.Y') }} auf das unten genannte Konto von {{ bank.holder }}.{% if payment_qr %} Oder scannen Sie den Code mit Ihrer Banking-App.{% endif %}</span>
    </section>
    {% endif %}
</body>
</html>
