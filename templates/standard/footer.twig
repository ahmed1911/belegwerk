{% set legal = custom.legal|default([]) -%}
{% if seller.vat_id %}{% set legal = legal|merge(['USt-IdNr.: ' ~ seller.vat_id]) %}{% endif -%}
{% if seller.tax_number %}{% set legal = legal|merge(['Steuernr.: ' ~ seller.tax_number]) %}{% endif -%}
{% if seller.phone %}{% set legal = legal|merge(['Tel.: ' ~ seller.phone]) %}{% endif -%}
{% if seller.email %}{% set legal = legal|merge([seller.email]) %}{% endif -%}
<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        html, body { margin: 0; padding: 0; font-family: Arial, sans-serif; color: #666; font-size: 9px; line-height: 1.15; }
        * { box-sizing: border-box; }
        .wrap { width: 100%; padding: 0 18.5mm; }
        .page { text-align: right; margin: 0 0 13mm; }
        .columns { display: flex; gap: 5mm; border-top: 1px solid #ddd; padding-top: 3mm; }
        .col { width: 33.333%; overflow-wrap: anywhere; }
        .col b { font-weight: 400; color: #444; }
    </style>
</head>
<body>
    <div class="wrap">
        <div class="page">Seite <span class="pageNumber"></span> von <span class="totalPages"></span></div>
        <div class="columns">
            <div class="col">
                <b>Firmenanschrift</b><br>{{ seller.name }}<br>
                {{- seller.address.street }}{% if seller.address.additional %}, {{ seller.address.additional }}{% endif %}, {{ seller.address.zip }} {{ seller.address.city }}
                {%- if seller.address.country != 'DE' %}, {{ seller.address.country }}{% endif %}
            </div>
            <div class="col"><b>Firmendaten</b><br>{{ legal|join(' · ') }}</div>
            <div class="col">
                <b>Bankverbindung</b><br>{{ bank.name|default(bank.holder) }}<br>IBAN {{ bank.iban|split('', 4)|join(' ') }}
                {%- if bank.bic %}<br>BIC {{ bank.bic }}{% endif %}
            </div>
        </div>
    </div>
</body>
</html>
